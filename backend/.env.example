# ==============================================================================
# NIVARA Backend Environment Configuration Template
# ==============================================================================

# --- Application ---
PROJECT_NAME="NIVARA Caregiver Community Backend"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000
API_V1_STR="/api/v1"

# --- Database ---
DATABASE_URL="sqlite:///./nivara.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nivara_db"

# --- JWT Authentication ---
SECRET_KEY="your-super-secret-jwt-key-here"
JWT_SECRET="your-super-secret-jwt-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Real-Time & WebSocket / Socket.IO ---
SOCKETIO_PATH="/socket.io"
SOCKET_CORS_ALLOWED_ORIGINS="*"
WS_URL="ws://localhost:8000/api/v1/ws"

# --- CORS Settings ---
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006"

# --- Media & Uploads ---
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10

# --- Safety & Geofencing ---
DEFAULT_SAFE_ZONE_RADIUS_METERS=150.0
SEPARATION_ALERT_THRESHOLD_METERS=50.0
LOW_BATTERY_ALERT_THRESHOLD=15
GPS_ACCURACY_THRESHOLD_METERS=100.0
LOCATION_UPDATE_INTERVAL_SECONDS=10
SMS_NOTIFICATIONS_ENABLED=true
PUSH_NOTIFICATIONS_ENABLED=true
